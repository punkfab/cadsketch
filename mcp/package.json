{
  "name": "cadsketch-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "CADSketch as an MCP App and Codex/ChatGPT plugin: models draw parts into the CADSketch editor, open .cadsketch/.dxf files in it, and read back what the user sketched.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "dev": "node build.mjs && node dist/main.js",
    "test": "node build.mjs && node --test \"test/*.test.mjs\"",
    "e2e": "node e2e/fake-host.mjs ../plugin/cadsketch/dist/widget.html"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/mcp-extensions": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
